# Backtester 환경변수 예시
# 복사: cp .env.example .env
# 실제 비밀번호는 .env에만 입력하고 GitHub에 커밋하지 마세요.

MCP_PORT=3846
MCP_HOST=127.0.0.1
LEAN_WORKSPACE=/tmp/lean_workspace

# 원격 PostgreSQL 연결 정보 (실제 비밀번호로 교체)
DATABASE_URL=postgresql://admin:admin1234@43.202.161.134:55432/admin

# 실제 DB 스키마: public.ohlcv
PG_OHLCV_TABLE=public.ohlcv
PG_SYMBOL_COLUMN=ticker_code
PG_DATE_COLUMN=trade_date
PG_OPEN_COLUMN=open
PG_HIGH_COLUMN=high
PG_LOW_COLUMN=low
PG_CLOSE_COLUMN=close
PG_VOLUME_COLUMN=volume
