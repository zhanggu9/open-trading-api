# Backtester 환경변수 예시
# 복사: cp .env.example .env
# 실제 비밀번호는 .env에만 입력하고 GitHub에 커밋하지 마세요.

MCP_PORT=3846
MCP_HOST=127.0.0.1
LEAN_WORKSPACE=/tmp/lean_workspace

# PostgreSQL 연결 정보 (실제 비밀번호로 교체)
DATABASE_URL=postgresql://admin:YOUR_PASSWORD@43.202.161.134:55432/admin

# OHLCV 테이블 및 컬럼 이름
# 아래는 예시입니다. 실제 PostgreSQL 스키마에 맞게 바꾸세요.
PG_OHLCV_TABLE=public.ohlcv_daily
PG_SYMBOL_COLUMN=symbol
PG_DATE_COLUMN=trade_date
PG_OPEN_COLUMN=open
PG_HIGH_COLUMN=high
PG_LOW_COLUMN=low
PG_CLOSE_COLUMN=close
PG_VOLUME_COLUMN=volume
