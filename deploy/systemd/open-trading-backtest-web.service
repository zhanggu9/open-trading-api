[Unit]
Description=LIMSON Backtester Web (Next.js 127.0.0.1:3001)
After=network-online.target open-trading-backtest-api.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@APP_DIR@/backtester/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=@NODE_BIN_DIR@:/usr/local/bin:/usr/bin:/bin
ExecStart=@NODE_BIN_DIR@/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
