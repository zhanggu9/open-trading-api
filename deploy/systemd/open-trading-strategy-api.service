[Unit]
Description=LIMSON Strategy Builder API (FastAPI 127.0.0.1:8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@APP_DIR@/strategy_builder
EnvironmentFile=-@APP_ENV_FILE@
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/strategy_builder/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
